# Installed as /etc/longcat-audiodit.env and readable only by root/longcat.
LONGCAT_MODEL_DIR=meituan-longcat/LongCat-AudioDiT-3.5B
LONGCAT_DEVICE=cuda:0
LONGCAT_HOST=0.0.0.0
LONGCAT_PORT=7861
LONGCAT_DATA_DIR=/var/lib/longcat-audiodit
LONGCAT_RESULT_TTL_HOURS=24
LONGCAT_MAX_PENDING_TASKS=20

# Hugging Face weights are cached outside the source checkout.
HF_HOME=/var/cache/longcat-audiodit/huggingface

# Optional for private/gated models and higher Hugging Face rate limits:
# HF_TOKEN=hf_xxx
